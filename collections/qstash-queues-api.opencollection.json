{
  "opencollection": "1.0.0",
  "info": {
    "name": "QStash Dead Letter Queue Queues API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Queues",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Enqueue a message to a FIFO queue",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://qstash.upstash.io/v2/enqueue/:queueName/:destination",
            "headers": [
              {
                "name": "Upstash-Delay",
                "value": ""
              },
              {
                "name": "Upstash-Retries",
                "value": ""
              },
              {
                "name": "Upstash-Deduplication-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "queueName",
                "value": "",
                "type": "path",
                "description": "Name of the target queue"
              },
              {
                "name": "destination",
                "value": "",
                "type": "path",
                "description": "Destination URL for message delivery"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a message to the specified FIFO queue for ordered delivery to the destination URL."
        },
        {
          "info": {
            "name": "Create or update a queue",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://qstash.upstash.io/v2/queues/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new queue or update an existing queue's configuration such as parallelism. Queues provide FIFO ordered message delivery."
        },
        {
          "info": {
            "name": "Get queue details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://qstash.upstash.io/v2/queues/:queueName",
            "params": [
              {
                "name": "queueName",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve configuration and status of a named queue."
        },
        {
          "info": {
            "name": "Delete a queue",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://qstash.upstash.io/v2/queues/:queueName",
            "params": [
              {
                "name": "queueName",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a queue and all its pending messages."
        },
        {
          "info": {
            "name": "Pause a queue",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://qstash.upstash.io/v2/queues/:queueName/pause",
            "params": [
              {
                "name": "queueName",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Pause delivery for a named queue."
        },
        {
          "info": {
            "name": "Resume a paused queue",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://qstash.upstash.io/v2/queues/:queueName/resume",
            "params": [
              {
                "name": "queueName",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Resume delivery for a paused queue."
        }
      ]
    }
  ],
  "bundled": true
}