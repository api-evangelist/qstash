          "name": "Create or update a schedule",
          "request": {
            "name": "Create or update a schedule",
            "description": {
              "content": "Create a CRON-scheduled recurring message delivery. The Upstash-Cron header defines the schedule. Timezone support via CRON_TZ prefix.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "schedules",
                ":destination"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "destination",
                  "description": "(Required) Destination URL, URL Group name, or queue destination"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) CRON expression (e.g. \"0 0 * * *\"). Supports timezone prefix like \"CRON_TZ=America/New_York 0 4 * * *\"",
                "key": "Upstash-Cron",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Specify or overwrite a schedule by ID",
                "key": "Upstash-Schedule-Id",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Route scheduled message to a named queue",
                "key": "Upstash-Queue-Name",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Number of retry attempts per scheduled delivery",
                "key": "Upstash-Retries",
                "value": "<integer>"
              },
              {
                "disabled": false,
                "description": "Delay each delivery after the scheduled trigger time",
                "key": "Upstash-Delay",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
